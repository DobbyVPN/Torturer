{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dobbyvpn.example/torturer/functional/scenario-v1.schema.json",
  "title": "DobbyVPN canonical functional scenario catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "scenarios"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "dobbyvpn.functional.scenario-catalog"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,95}$"},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "timeout_seconds"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "operation": {"$ref": "#/$defs/identifier"},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "steps", "required_capabilities", "assertion_ids", "max_duration_seconds"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"const": 1},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
        "assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "max_duration_seconds": {"type": "integer", "minimum": 1}
      }
    }
  }
}
